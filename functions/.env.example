# Variables de entorno para la Cloud Function `api` (2nd gen).
# Copia este archivo a functions/.env (o functions/.env.<project-id> para un
# proyecto específico) — Firebase las carga automáticamente en runtime.
# No necesitas STORAGE_DRIVER aquí: functions/src/index.ts ya fuerza "firebase".
# Tampoco necesitas credenciales de Firestore: en Cloud Functions el Admin SDK
# usa las credenciales del propio proyecto automáticamente.
#
# OJO: no uses nombres de variable que empiecen con FIREBASE_, X_GOOGLE_ o
# EXT_ — Firebase Functions los reserva para uso interno y el deploy entero
# falla ("Failed to load environment variables... reserved prefix") si
# aparece alguno en este archivo. Por eso el bucket se llama STORAGE_BUCKET
# y no FIREBASE_STORAGE_BUCKET.

CORS_ORIGINS=https://tu-site-vendedor.web.app,https://tu-site-admin.web.app

# Ver .env.example en la raíz para la explicación completa.
INITIAL_ADMIN_EMAILS=

STORAGE_BUCKET=tu-project-id.appspot.com

DENUE_TOKEN=
GOOGLE_MAPS_API_KEY=
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
AVIVA_HR_PROJECT_ID=
