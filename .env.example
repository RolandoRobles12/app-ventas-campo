# Backend server
PORT=4000

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Comma-separated @avivacredito.com emails that always get admin access to the
# admin panel (collection `usuarios`, rol 'admin'). Applied once on server
# startup (server/src/auth.ts, bootstrapInitialAdmins) — needed to create the
# very first admin, since the "Usuarios" screen that grants that role only
# admins can open. Also self-heals: if one of these emails is ever removed
# from "Usuarios" by mistake, it's restored on the next restart/deploy.
INITIAL_ADMIN_EMAILS=

# --- Firestore (base de datos) ---
# Ruta a la clave de cuenta de servicio que descargaste en la consola de
# Firebase (Configuración del proyecto > Cuentas de servicio > Generar nueva
# clave privada). Guárdala FUERA de este repo. El project ID se infiere solo
# de la clave, no hace falta configurarlo aparte. Ver README para el paso a paso.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/tu-usuario/secrets/aviva-firebase-adminsdk.json

# --- Alternativa: emulador de Firestore (offline, requiere Java) ---
# Deja GOOGLE_APPLICATION_CREDENTIALS arriba comentado/vacío y descomenta esto
# para usar `npm run dev:emulator` en vez de `npm run dev` (ver README).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=app-campo-aviva

# --- DENUE (INEGI) real integration ---
# Get a token at https://www.inegi.org.mx/servicios/api_denue.html
DENUE_TOKEN=

# --- Google Maps (Geocoding API) ---
# Convierte "Ciudad/Municipio" + "Colonia o C.P." (RouteWizard, pestaña "Por
# municipio / colonia / C.P.") en lat/lng para poder buscar con el DENUE en
# cualquier parte del país — el DENUE por sí solo no acepta texto libre de
# ubicación, solo entidad federativa o coordenadas+radio. Sin esta variable,
# esa pestaña muestra un aviso y solo funciona la de "Por ubicación (GPS)".
# 1. Google Cloud Console > crea/usa un proyecto > habilita "Geocoding API".
# 2. Credenciales > crear API key > restríngela a "Geocoding API" únicamente.
GOOGLE_MAPS_API_KEY=

# --- HubSpot real integration ---
# Create a Private App in HubSpot (Settings > Integrations > Private Apps) with
# these scopes: crm.objects.deals.read, crm.objects.deals.write,
# crm.objects.companies.read, crm.objects.owners.read, crm.schemas.deals.read,
# crm.schemas.deals.write (the last two are required to create/read the
# "aviva_service_owner" custom property — without them, Service owner never
# actually saves to HubSpot even though the token "works").
HUBSPOT_TOKEN=
# Your HubSpot account/portal ID (top right of the HubSpot UI, or Settings > Account Setup)
HUBSPOT_PORTAL_ID=
# There is no HUBSPOT_PIPELINE_ID env var anymore: the "Nuevas visitas"
# pipeline is auto-detected by looking for the stage whose id matches
# FUNNEL_STAGE_IDS.aprobado in server/src/integrations/hubspot.ts. Only deals
# from that pipeline are synced — update the ids there if the pipeline is
# ever recreated in HubSpot (its stage ids would change).
# That pipeline MUST have stages named exactly (case insensitive): Documentos
# subidos, Documentos verificados, Aprobado, Contrato enviado, Desembolso,
# Rechazado — otherwise stage changes made in the admin app are silently not
# pushed to HubSpot.

# --- aviva-hr (directorio real de empleados, otro proyecto de Firebase) ---
# Permite importar vendedores reales desde aviva-hr en vez de darlos de alta a
# mano (ver "Rutas por vendedor" -> Sincronizar). El backend no tiene cuenta
# de servicio de ese proyecto, así que lee su REST API pública de Firestore
# (requiere que las reglas de Firestore de aviva-hr permitan lectura no
# autenticada de la colección `users`). Sin este valor, la sincronización
# simplemente se muestra como "No configurado" en el admin.
AVIVA_HR_PROJECT_ID=

# --- Fotos de visitas ---
# Las fotos se suben directo del navegador a Firebase Storage (ver
# apps/seller/src/uploadFotos.ts y storage.rules en la raíz); el servidor solo
# recibe y valida las URLs resultantes, no necesita ninguna variable propia.
