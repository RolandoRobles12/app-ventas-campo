# Backend server
PORT=4000

# CORS - comma separated origins allowed to call the API
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Comma-separated @avivacredito.com emails that always get admin access to the
# admin panel (collection `usuarios`, rol 'admin'). Applied once on server
# startup (server/src/auth.ts, bootstrapInitialAdmins) — needed to create the
# very first admin, since the "Usuarios" screen that grants that role only
# admins can open. Also self-heals: if one of these emails is ever removed
# from "Usuarios" by mistake, it's restored on the next restart/deploy.
INITIAL_ADMIN_EMAILS=

# --- Firestore (base de datos) ---
# Ruta a la clave de cuenta de servicio que descargaste en la consola de
# Firebase (Configuración del proyecto > Cuentas de servicio > Generar nueva
# clave privada). Guárdala FUERA de este repo. El project ID se infiere solo
# de la clave, no hace falta configurarlo aparte. Ver README para el paso a paso.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/tu-usuario/secrets/aviva-firebase-adminsdk.json

# --- Alternativa: emulador de Firestore (offline, requiere Java) ---
# Deja GOOGLE_APPLICATION_CREDENTIALS arriba comentado/vacío y descomenta esto
# para usar `npm run dev:emulator` en vez de `npm run dev` (ver README).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=app-campo-aviva

# --- DENUE (INEGI) real integration ---
# Get a token at https://www.inegi.org.mx/servicios/api_denue.html
DENUE_TOKEN=

# --- Google Maps (Geocoding API) ---
# Solo se usa cuando en el planeador de rutas el admin escribe una zona sin
# elegir una sugerencia del buscador: el servidor convierte ese texto en
# lat/lng para consultar el DENUE (que no acepta texto libre de ubicación).
# Elegir una sugerencia o hacer clic en el mapa no la necesita.
# 1. Google Cloud Console > crea/usa un proyecto > habilita "Geocoding API".
# 2. Credenciales > crear API key > restríngela a "Geocoding API" únicamente.
GOOGLE_MAPS_API_KEY=

# --- Base de colaboradores (aviva-recruiting) ---
# De aquí salen las altas y bajas de los vendedores de campo (ver README,
# "Equipo: base de colaboradores"). Sin este valor, "Equipo" en el admin se
# muestra como "No configurado".
RECRUITING_PROJECT_ID=aviva-recruiting
# Opcional. Por defecto se usan las credenciales del entorno
# (GOOGLE_APPLICATION_CREDENTIALS en local, la cuenta de servicio de la
# función en producción), que necesitan el rol "Cloud Datastore Viewer" en el
# proyecto aviva-recruiting. Si en vez de eso te dan una cuenta de servicio de
# aviva-recruiting, pega aquí su JSON en una sola línea (o en base64).
RECRUITING_SERVICE_ACCOUNT=

# --- Fotos de visitas ---
# Las fotos se suben directo del navegador a Firebase Storage (ver
# apps/seller/src/uploadFotos.ts y storage.rules en la raíz); el servidor solo
# recibe y valida las URLs resultantes, no necesita ninguna variable propia.
