# Copia este archivo a apps/seller/.env (no se sube a git) y complétalo.

# Google Maps JavaScript API — usada por la pestaña "Mapa" de la ruta
# (apps/seller/src/pages/Mapa.tsx). Es una clave expuesta en el
# navegador (normal para este uso): protégela restringiéndola por HTTP
# referrer en Google Cloud Console a los dominios donde corre la app del
# vendedor (localhost:5173 en desarrollo, tu dominio de Hosting en
# producción), no ocultándola. Puede ser la misma clave que ya usas en
# apps/admin/.env (misma API habilitada: "Maps JavaScript API").
VITE_GOOGLE_MAPS_API_KEY=

# Avisos de citas (notificaciones push). Clave pública de Firebase Console →
# Configuración del proyecto → Cloud Messaging → "Certificados de push web"
# (Generar par de claves). No es secreta. Sin ella, la app no ofrece activar
# los avisos. Funcionan solo en el build de producción (el service worker
# no se registra en `npm run dev`).
VITE_FIREBASE_VAPID_KEY=
